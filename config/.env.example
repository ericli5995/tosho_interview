# Only needed for running WITHOUT Docker (php -S / local Apache).
# Under docker compose these come from docker-compose.yml as real env vars.
# Copy to config/.env and adjust for your machine.

APP_NAME="THINK ENGINEERING"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Use 127.0.0.1 (not "localhost") to force a TCP connection to MySQL.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tosho_dev
DB_USER=root
DB_PASS=

# Max size per uploaded image, in bytes (5 MiB default).
UPLOAD_MAX_BYTES=5242880
