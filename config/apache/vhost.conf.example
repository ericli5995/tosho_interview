# Sample Apache 2.4 virtual host.
#
# Homebrew's php@8.2 no longer ships mod_php (libphp.so). The supported way to
# run PHP under Apache is php-fpm + mod_proxy_fcgi - this is also the standard
# production setup (Apache/nginx in front, php-fpm behind), not a workaround.
#
# Setup (Homebrew httpd - no sudo, no system files touched):
#   brew install httpd
#   In /opt/homebrew/etc/httpd/httpd.conf, uncomment:
#     LoadModule rewrite_module lib/httpd/modules/mod_rewrite.so
#     LoadModule proxy_module lib/httpd/modules/mod_proxy.so
#     LoadModule proxy_fcgi_module lib/httpd/modules/mod_proxy_fcgi.so
#   Then add at the bottom of httpd.conf:
#     Include /opt/homebrew/etc/httpd/extra/tosho.conf
#   Copy this file there (adjust the paths below to your checkout), then:
#     brew services start php@8.2   # php-fpm, listens on 127.0.0.1:9000 by default
#     brew services start httpd
#
# (macOS also ships its own Apache 2.4 at /etc/apache2/httpd.conf with the same
# modules available - an equally valid target, just needs sudo to edit/restart.)

Listen 8080

<VirtualHost *:8080>
    ServerName tosho.localhost
    DocumentRoot "/Users/ericli/Desktop/Interview/tosho_interview/public"

    <Directory "/Users/ericli/Desktop/Interview/tosho_interview/public">
        # AllowOverride All lets public/.htaccess drive the rewrite.
        AllowOverride All
        Options +FollowSymLinks -Indexes
        Require all granted
    </Directory>

    # Hand .php requests to php-fpm over FastCGI.
    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9000"
    </FilesMatch>

    ErrorLog "/Users/ericli/Desktop/Interview/tosho_interview/storage/logs/apache-error.log"
    CustomLog "/Users/ericli/Desktop/Interview/tosho_interview/storage/logs/apache-access.log" common
</VirtualHost>
