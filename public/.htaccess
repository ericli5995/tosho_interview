# Apache 2.4 - public/ is the DocumentRoot.

# Without this, a request for "/" tries Apache's default DirectoryIndex
# (index.html), finds nothing, and 403s before the rewrite below ever runs.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve existing files and directories directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource /index.php
</IfModule>

# Needed so the media/ symlink to ../storage/uploads can be served.
Options +FollowSymLinks -Indexes
AddDefaultCharset UTF-8

# Never serve dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
